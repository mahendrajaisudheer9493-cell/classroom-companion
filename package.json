    "eval": "echo 'eval not implemented yet'",
    "postinstall": "prisma generate",
    "demo:unauthorized": "tsx scripts/demo-unauthorized.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@prisma/client": "^6.19.3",
    "grammy": "^1.46.0",
    "luxon": "^3.7.2",
    "next": "16.4.6",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "prisma": {
