# Classroom Companion: environment variables
# Copy to .env (`cp .env.example .env`) and fill in. Never commit .env.
# Validated at runtime by lib/env.ts; it lists every missing/invalid variable.

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Supabase dashboard → Project → Connect → "ORMs" / connection string.
# Pooled URL (Transaction pooler, port 6543). Used by the app at runtime.
# Keep ?pgbouncer=true&connection_limit=1 (serverless + Prisma need it).
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct URL (Session/direct, port 5432). Used only by Prisma migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Telegram ──────────────────────────────────────────────────────────────────
# Talk to @BotFather → /newbot → copy the token it gives you.
TELEGRAM_BOT_TOKEN="123456789:replace-with-token-from-botfather"
# Any random string (16-256 chars, A-Z a-z 0-9 _ -). Telegram sends it back in the
# X-Telegram-Bot-Api-Secret-Token header so we know webhook calls are genuine.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET="replace-with-random-hex"
# Your bot's username without the @ (shown by BotFather), used to build t.me links.
TELEGRAM_BOT_USERNAME="YourClassroomBot"

# ── App ───────────────────────────────────────────────────────────────────────
# Public https URL of the deployed app (Vercel URL, or an https tunnel in dev).
# Used for the webhook URL and the Mini App (web_app) buttons.
APP_URL="https://your-app.vercel.app"
# Shared secret for POST /api/tick (Authorization: Bearer <CRON_SECRET>).
# Put the same value in scripts/supabase-cron.sql. Generate: openssl rand -hex 32
CRON_SECRET="replace-with-random-hex"

# ── LLM (Anthropic) ───────────────────────────────────────────────────────────
# console.anthropic.com → Settings → API keys.
ANTHROPIC_API_KEY="sk-ant-replace-me"
# Model id. Default: claude-haiku-5-5
ANTHROPIC_MODEL="claude-haiku-5-5"
# Below this confidence (0-1) the bot asks with buttons instead of acting. Default 0.7
LLM_CONFIDENCE_THRESHOLD="0.7"
# Give up on the model after this many ms and fall back to buttons/form. Default 8000
LLM_TIMEOUT_MS="8000"

# ── Scheduling (all times IST, Asia/Kolkata) ──────────────────────────────────
# No messages to students from QUIET_HOURS_START:00 to QUIET_HOURS_END:00. Defaults 21 / 7
QUIET_HOURS_START="21"
QUIET_HOURS_END="7"
# A student is "silent" this many minutes after delivery with no activity.
# Pilot 720 (12 h); use 2 for a live demo. Default 720
SILENT_AFTER_MINUTES="720"
# Hour of the "due tomorrow" reminder on the evening before. Default 18
DUE_SOON_HOUR="18"
# Teacher morning digest time, HH:MM 24h. Default 07:30
DIGEST_TIME="07:30"

# ── Demo / development ────────────────────────────────────────────────────────
# true = show demo helpers such as [Run reminders now]. Default false
DEMO_MODE="false"
# Optional. Local dev only (ignored when NODE_ENV=production): open the Mini App in
# a normal browser as this Telegram user, without signed initData.
DEV_AUTH_TELEGRAM_ID=""

# ── Seed data (npm run db:seed) ───────────────────────────────────────────────
# Your real Telegram numeric user IDs, so seeded accounts are yours.
# Get one: message @userinfobot on Telegram, it replies with your "Id".
SEED_TEACHER_TELEGRAM_ID="111111111"
SEED_STUDENT_TELEGRAM_ID="222222222"
# Optional. Defaults to SEED_TEACHER_TELEGRAM_ID (one account plays teacher + coordinator).
SEED_COORDINATOR_TELEGRAM_ID=""
